<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <AssemblyName>SiNiSistar2.Pleasure.Plugin</AssemblyName>
    <RootNamespace>SiNiSistar2.Pleasure.Plugin</RootNamespace>
    <BepInExRoot Condition="'$(BepInExRoot)' == '' and '$(SINISISTAR2_BEPINEX_ROOT)' != ''">$(SINISISTAR2_BEPINEX_ROOT)</BepInExRoot>
    <BepInExRoot Condition="'$(BepInExRoot)' == ''">$(MSBuildProjectDirectory)\..\..\BepInEx</BepInExRoot>
    <RuntimePluginDir>$(MSBuildProjectDirectory)\..\..\BepInEx\plugins\community.sinisistar2.pleasure</RuntimePluginDir>
  </PropertyGroup>

  <Target Name="ValidateBepInExRoot" BeforeTargets="ResolveReferences">
    <Error Condition="!Exists('$(BepInExRoot)\core\BepInEx.Unity.IL2CPP.dll')" Text="Set BepInExRoot or SINISISTAR2_BEPINEX_ROOT to a generated SiNiSistar2 BepInEx directory." />
    <Error Condition="!Exists('$(BepInExRoot)\interop\SiNiSistar2.dll')" Text="The selected BepInExRoot does not contain SiNiSistar2 interop assemblies. Start the game once with BepInEx 6 first." />
  </Target>

  <!-- REFACTOR001 RF-001: shared by source, not by assembly. Every MOD needs the same
       once-per-process startup work, but a shared DLL would make each MOD depend on it and
       break single-MOD installs and independent updates (RJ-903). Linking the file keeps the
       assemblies self-contained. -->
  <ItemGroup>
    <Compile Include="..\Shared\StartupGuard.cs" Link="StartupGuard.cs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\SiNiSistar2.Pleasure.Core\SiNiSistar2.Pleasure.Core.csproj" />
    <Reference Include="BepInEx.Core" HintPath="$(BepInExRoot)\core\BepInEx.Core.dll" Private="false" />
    <Reference Include="BepInEx.Unity.IL2CPP" HintPath="$(BepInExRoot)\core\BepInEx.Unity.IL2CPP.dll" Private="false" />
    <Reference Include="BepInEx.Unity.Common" HintPath="$(BepInExRoot)\core\BepInEx.Unity.Common.dll" Private="false" />
    <Reference Include="0Harmony" HintPath="$(BepInExRoot)\core\0Harmony.dll" Private="false" />
    <Reference Include="Il2CppInterop.Runtime" HintPath="$(BepInExRoot)\core\Il2CppInterop.Runtime.dll" Private="false" />
    <Reference Include="Il2Cppmscorlib" HintPath="$(BepInExRoot)\interop\Il2Cppmscorlib.dll" Private="false" />
    <Reference Include="Il2CppSystem" HintPath="$(BepInExRoot)\interop\Il2CppSystem.dll" Private="false" />
    <Reference Include="SiNiSistar2" HintPath="$(BepInExRoot)\interop\SiNiSistar2.dll" Private="false" />
    <Reference Include="UniTask" HintPath="$(BepInExRoot)\interop\UniTask.dll" Private="false" />
    <Reference Include="UniRx" HintPath="$(BepInExRoot)\interop\UniRx.dll" Private="false" />
    <Reference Include="UnityEngine.AnimationModule" HintPath="$(BepInExRoot)\interop\UnityEngine.AnimationModule.dll" Private="false" />
    <Reference Include="UnityEngine.CoreModule" HintPath="$(BepInExRoot)\interop\UnityEngine.CoreModule.dll" Private="false" />
    <Reference Include="UnityEngine.ImageConversionModule" HintPath="$(BepInExRoot)\interop\UnityEngine.ImageConversionModule.dll" Private="false" />
    <Reference Include="UnityEngine.IMGUIModule" HintPath="$(BepInExRoot)\interop\UnityEngine.IMGUIModule.dll" Private="false" />
    <!-- Polled rather than read from Event.current: the MP0 penalty needs to know an action key is
         held, and a KeyDown event auto-repeats, which would re-roll for a key nobody pressed again
         (SPEC005 FR-410). -->
    <Reference Include="UnityEngine.InputLegacyModule" HintPath="$(BepInExRoot)\interop\UnityEngine.InputLegacyModule.dll" Private="false" />
    <Reference Include="UnityEngine.UI" HintPath="$(BepInExRoot)\interop\UnityEngine.UI.dll" Private="false" />
  </ItemGroup>

  <Target Name="DeployToRepositoryRuntime" AfterTargets="Build">
    <MakeDir Directories="$(RuntimePluginDir)" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(RuntimePluginDir)" />
    <Copy SourceFiles="$(MSBuildProjectDirectory)\..\SiNiSistar2.Pleasure.Core\bin\$(Configuration)\net6.0\SiNiSistar2.Pleasure.Core.dll" DestinationFolder="$(RuntimePluginDir)" />
  </Target>
</Project>
